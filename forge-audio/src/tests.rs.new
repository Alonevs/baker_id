    #[test]
    fn test_audio_sample_default() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        
        assert_eq!(sample.id, "sample1");
        assert_eq!(sample.name, "Sample 1");
        assert_eq!(sample.format, AudioFormat::Wav);
        assert_eq!(sample.duration, 0.0);
        assert_eq!(sample.sample_rate, 44100);
        assert_eq!(sample.channels, 1);
        assert!(sample.data.is_empty());
    }

    #[test]
    fn test_audio_sample_format_display() {
        assert_eq!(format!("{}", AudioFormat::Wav), "WAV");
        assert_eq!(format!("{}", AudioFormat::Mp3), "MP3");
        assert_eq!(format!("{}", AudioFormat::Ogg), "OGG");
        assert_eq!(format!("{}", AudioFormat::Flac), "FLAC");
        assert_eq!(format!("{}", AudioFormat::Aiff), "AIFF");
    }

    #[test]
    fn test_audio_sample_data_and_duration() {
        let mut sample = AudioSample::new(
            "sample2".to_string(),
            "Sample 2".to_string(),
            std::path::PathBuf::from("test2.wav")
        );
        
        sample.set_data(vec![0x00, 0x01, 0x02, 0x03]);
        sample.set_duration(2.5);
        
        assert_eq!(sample.data.len(), 4);
        assert_eq!(sample.data[0], 0x00);
        assert_eq!(sample.duration, 2.5);
    }

    #[test]
    fn test_audio_sample_channel_display() {
        assert_eq!(format!("{}", AudioChannel::Mono), "Mono");
        assert_eq!(format!("{}", AudioChannel::Stereo), "Stereo");
        assert_eq!(format!("{}", AudioChannel::Surround51), "Surround51");
        assert_eq!(format!("{}", AudioChannel::Surround71), "Surround71");
    }

    #[test]
    fn test_audio_sample_different_formats() {
        let wav_path = std::path::PathBuf::from("test.wav");
        let mp3_path = std::path::PathBuf::from("test.mp3");
        let flac_path = std::path::PathBuf::from("test.flac");
        
        let mut wav_sample = AudioSample::new("wav1".to_string(), "WAV Sample".to_string(), wav_path.clone());
        let mut mp3_sample = AudioSample::new("mp31".to_string(), "MP3 Sample".to_string(), mp3_path.clone());
        let mut flac_sample = AudioSample::new("flac1".to_string(), "FLAC Sample".to_string(), flac_path.clone());
        
        // Establecer formatos explÃ­citamente
        wav_sample.format = AudioFormat::Wav;
        mp3_sample.format = AudioFormat::Mp3;
        flac_sample.format = AudioFormat::Flac;
        
        assert_eq!(wav_sample.format, AudioFormat::Wav);
        assert_eq!(mp3_sample.format, AudioFormat::Mp3);
        assert_eq!(flac_sample.format, AudioFormat::Flac);
        
        assert_eq!(wav_sample.sample_rate, 44100);
        assert_eq!(mp3_sample.sample_rate, 44100);
        assert_eq!(flac_sample.sample_rate, 44100);
    }

    #[test]
    fn test_audio_sample_sample_rate_and_channels() {
        let mut sample = AudioSample::new(
            "sample3".to_string(),
            "Sample 3".to_string(),
            std::path::PathBuf::from("test3.wav")
        );
        
        sample.set_data(vec![0x00, 0x01, 0x02, 0x03]);
        sample.set_duration(3.0);
        
        // Verificar valores por defecto
        assert_eq!(sample.sample_rate, 44100);
        assert_eq!(sample.channels, 1);
        
        // Verificar que se pueden modificar
        sample.sample_rate = 48000;
        sample.channels = 2;
        
        assert_eq!(sample.sample_rate, 48000);
        assert_eq!(sample.channels, 2);
    }
