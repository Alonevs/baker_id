    #[test]
    fn test_audio_bus_default_creation() {
        let bus = AudioBus::new(
            "bus1".to_string(),
            "Bus 1".to_string(),
            BusType::Master
        );
        
        assert_eq!(bus.id, "bus1");
        assert_eq!(bus.name, "Bus 1");
        assert_eq!(bus.bus_type, BusType::Master);
        assert_eq!(bus.volume, 1.0);
        assert_eq!(bus.pan, 0.0);
        assert!(!bus.muted);
        assert!(!bus.solo);
        assert!(bus.enabled);
        assert!(bus.inputs.is_empty());
        assert!(bus.outputs.is_empty());
        assert!(bus.effects.is_empty());
    }

    #[test]
    fn test_audio_bus_connections() {
        let mut bus = AudioBus::new(
            "bus1".to_string(),
            "Bus 1".to_string(),
            BusType::Sfx
        );
        
        // Agregar inputs y outputs
        bus.add_input("input1".to_string());
        bus.add_input("input2".to_string());
        bus.add_output("output1".to_string());
        bus.connect("master_bus".to_string());
        
        assert_eq!(bus.get_input_count(), 2);
        assert_eq!(bus.get_output_count(), 2);
        assert!(bus.is_connected_to("master_bus"));
    }

    #[test]
    fn test_audio_bus_system() {
        let mut system = AudioBusSystem::new();
        
        assert_eq!(system.get_bus_count(), 1);
        assert_eq!(system.get_master_bus_id(), "master_bus");
        
        // Verificar bus master existe
        let bus = system.get_bus("master_bus").unwrap();
        assert_eq!(bus.bus_type, BusType::Master);
        assert_eq!(bus.name, "Master Bus");
        
        // Agregar nuevo bus
        let new_bus = AudioBus::new(
            "sfx_bus".to_string(),
            "SFX Bus".to_string(),
            BusType::Sfx
        );
        system.add_bus(new_bus);
        
        assert_eq!(system.get_bus_count(), 2);
        assert_eq!(system.get_bus_type("sfx_bus").unwrap(), BusType::Sfx);
    }

    #[test]
    fn test_audio_bus_volume_and_pan() {
        let mut bus = AudioBus::new(
            "test_bus".to_string(),
            "Test Bus".to_string(),
            BusType::Sfx
        );
        
        // Volumen > 1.0 (debe mantenerse)
        bus.volume = 1.5;
        assert_eq!(bus.volume, 1.5);
        
        // Volumen < 0.0 (debe mantenerse)
        bus.volume = -0.5;
        assert_eq!(bus.volume, -0.5);
        
        // Pan > 1.0 (debe mantenerse)
        bus.pan = 1.5;
        assert_eq!(bus.pan, 1.5);
        
        // Pan < -1.0 (debe mantenerse)
        bus.pan = -1.5;
        assert_eq!(bus.pan, -1.5);
    }

    #[test]
    fn test_audio_bus_inputs_outputs_effects() {
        let mut bus = AudioBus::new(
            "test_bus".to_string(),
            "Test Bus".to_string(),
            BusType::Sfx
        );
        
        // Agregar inputs
        bus.add_input("input1".to_string());
        bus.add_input("input2".to_string());
        assert_eq!(bus.get_input_count(), 2);
        
        // Agregar outputs
        bus.add_output("output1".to_string());
        bus.add_output("output2".to_string());
        assert_eq!(bus.get_output_count(), 2);
        
        // Agregar efectos
        bus.add_effect("effect1".to_string());
        bus.add_effect("effect2".to_string());
        assert_eq!(bus.get_effect_count(), 2);
        
        // Verificar que no hay duplicados
        bus.add_input("input1".to_string());
        assert_eq!(bus.get_input_count(), 2); // No deberÃ­a aumentar
        
        bus.add_output("output1".to_string());
        assert_eq!(bus.get_output_count(), 2); // No deberÃ­a aumentar
        
        bus.add_effect("effect1".to_string());
        assert_eq!(bus.get_effect_count(), 2); // No deberÃ­a aumentar
    }

    #[test]
    fn test_audio_bus_remove_and_connect() {
        let mut bus = AudioBus::new(
            "test_bus".to_string(),
            "Test Bus".to_string(),
            BusType::Sfx
        );
        
        // Agregar inputs y outputs
        bus.add_input("input1".to_string());
        bus.add_input("input2".to_string());
        bus.add_output("output1".to_string());
        bus.add_output("output2".to_string());
        
        // Remover input
        bus.remove_input("input1");
        assert_eq!(bus.get_input_count(), 1);
        
        // Remover output
        bus.remove_output("output1");
        assert_eq!(bus.get_output_count(), 1);
        
        // Conectar a otro bus
        bus.connect("master_bus".to_string());
        assert_eq!(bus.get_output_count(), 2);
        
        // Verificar conexiÃ³n
        assert!(bus.is_connected_to("master_bus"));
        assert!(!bus.is_connected_to("nonexistent"));
        
        // Remover bus del sistema
        let mut system = AudioBusSystem::new();
        let new_bus = AudioBus::new(
            "removable_bus".to_string(),
            "Removable Bus".to_string(),
            BusType::Music
        );
        system.add_bus(new_bus);
        
        assert_eq!(system.get_bus_count(), 2);
        system.remove_bus("removable_bus");
        assert_eq!(system.get_bus_count(), 1);
    }

