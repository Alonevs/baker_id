    #[test]
    fn test_audio_source_default_state() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let source = AudioSource::new(sample);
        
        assert_eq!(source.state, SourceState::Stopped);
        assert_eq!(source.playback_mode, PlaybackMode::Once);
        assert_eq!(source.position, 0.0);
        assert_eq!(source.total_duration, 0.0);
        assert_eq!(source.volume, 1.0);
        assert_eq!(source.pitch, 1.0);
        assert_eq!(source.pan, 0.0);
        assert!(source.callback.is_none());
    }

    #[test]
    fn test_audio_source_playback_modes() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        
        // Play
        source.play(None);
        assert_eq!(source.state, SourceState::Playing);
        assert_eq!(source.position, 0.0);
        
        // Pause
        source.pause();
        assert_eq!(source.state, SourceState::Paused);
        
        // Stop
        source.stop();
        assert_eq!(source.state, SourceState::Stopped);
        assert_eq!(source.position, 0.0);
    }

    #[test]
    fn test_audio_source_update() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        source.total_duration = 1.0;
        source.play(None);
        
        // Actualizar 0.1 segundos a 44100 Hz
        source.update(0.1, 44100);
        
        // PosiciÃ³n debe avanzar (aprox 4410 muestras en 0.1s)
        assert!(source.position > 0.0);
        
        // Verificar getters
        assert_eq!(source.get_position(), source.position);
        assert_eq!(source.get_duration(), 1.0);
        assert_eq!(source.get_volume(), 1.0);
    }

    #[test]
    fn test_audio_source_volume_pitch_pan() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        
        // Test volume clamping
        source.set_volume(1.5);
        assert_eq!(source.get_volume(), 1.0);
        
        source.set_volume(-0.5);
        assert_eq!(source.get_volume(), 0.0);
        
        source.set_volume(0.5);
        assert_eq!(source.get_volume(), 0.5);
        
        // Test pitch minimum
        source.set_pitch(0.0);
        assert_eq!(source.get_pitch(), 0.1);
        
        source.set_pitch(2.0);
        assert_eq!(source.get_pitch(), 2.0);
        
        // Test pan clamping
        source.set_pan(2.0);
        assert_eq!(source.get_pan(), 1.0);
        
        source.set_pan(-2.0);
        assert_eq!(source.get_pan(), -1.0);
        
        source.set_pan(0.0);
        assert_eq!(source.get_pan(), 0.0);
    }

    #[test]
    fn test_audio_source_loop_and_finish() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        source.total_duration = 1.0;
        source.set_loop(0.0, 0.5);
        
        // Test Once mode - should finish
        source.play(None);
        source.update(1.0, 44100);
        assert_eq!(source.state, SourceState::Finished);
        
        // Test Loop mode - should loop
        source.stop();
        source.play(None);
        source.set_playback_mode(PlaybackMode::Loop);
        source.update(2.0, 44100);
        assert_eq!(source.state, SourceState::Playing);
        assert!(source.position >= 0.0 && source.position < 0.5);
    }

    #[test]
    fn test_audio_source_set_loop() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        source.total_duration = 2.0;
        
        // Set loop range
        source.set_loop(0.5, 1.5);
        
        assert_eq!(source.loop_start, 0.5);
        assert_eq!(source.loop_end, 1.5);
        
        // Test update with loop
        source.play(None);
        source.set_playback_mode(PlaybackMode::Loop);
        source.update(3.0, 44100);
        
        // DeberÃ­a estar en el rango de loop (0.5-1.5)
        assert!(source.position >= 0.5 && source.position <= 1.5);
    }

    #[test]
    fn test_audio_source_callback() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        source.total_duration = 1.0;
        
        // Callback counter
        static CALLBACK_COUNT: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0);
        let callback = Box::new(|| {
            CALLBACK_COUNT.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
        });
        
        // Reset counter for this test
        CALLBACK_COUNT.store(0, std::sync::atomic::Ordering::SeqCst);
        
        // Play with callback
        source.play(Some(callback));
        source.update(0.5, 44100);
        
        // Callback debe haberse ejecutado al menos una vez
        assert!(CALLBACK_COUNT.load(std::sync::atomic::Ordering::SeqCst) > 0);
        
        // Verificar que el source sigue funcionando
        assert_eq!(source.get_volume(), 1.0);
        assert_eq!(source.get_pitch(), 1.0);
    }

    #[test]
    fn test_audio_source_state_transitions() {
        let sample = AudioSample::new(
            "sample1".to_string(),
            "Sample 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        let mut source = AudioSource::new(sample);
        source.total_duration = 1.0;
        
        // Start from Stopped
        assert_eq!(source.state, SourceState::Stopped);
        
        // Play -> Playing
        source.play(None);
        assert_eq!(source.state, SourceState::Playing);
        
        // Playing -> Paused
        source.pause();
        assert_eq!(source.state, SourceState::Paused);
        
        // Paused -> Playing (pause no cambia el estado directamente, pero sigue en Paused)
        // El estado cambia en update si estÃ¡ playing
        source.update(0.1, 44100);
        assert_eq!(source.state, SourceState::Paused); // update no cambia estado si estÃ¡ paused
        
        // Stop -> Stopped
        source.stop();
        assert_eq!(source.state, SourceState::Stopped);
        
        // Verificar que position reseteÃ³
        assert_eq!(source.position, 0.0);
        
        // Verificar que callback se reseteÃ³
        assert!(source.callback.is_none());
    }

    // =========================================================================
    // SPATIAL AUDIO TESTS (3 tests)
    // =========================================================================

    #[test]
    fn test_spatial_audio_source_default() {
        let source = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        
        assert_eq!(source.id, "spatial1");
        assert_eq!(source.name, "Spatial 1");
        assert_eq!(source.position.x, 0.0);
        assert_eq!(source.position.y, 0.0);
        assert_eq!(source.position.z, 0.0);
        assert_eq!(source.volume, 1.0);
        assert_eq!(source.pitch, 1.0);
        assert_eq!(source.pan, 0.0);
        assert!(source.enabled);
        assert_eq!(source.min_distance, 1.0);
        assert_eq!(source.max_distance, 1000.0);
    }

    #[test]
    fn test_spatial_audio_position_update() {
        let mut source = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        source.set_position(AudioPosition::new(0.0, 0.0, 0.0));
        source.set_velocity(AudioPosition::new(10.0, 0.0, 0.0));
        
        // Actualizar 0.1 segundos
        source.update(0.1);
        
        assert_eq!(source.position.x, 1.0);
        assert_eq!(source.position.y, 0.0);
        assert_eq!(source.position.z, 0.0);
    }

    #[test]
    fn test_spatial_audio_distance_gain() {
        let mut source = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        source.set_listener(AudioPosition::new(0.0, 0.0, 0.0));
        source.set_position(AudioPosition::new(100.0, 0.0, 0.0));
        
        // Ganancia a 100 unidades
        let gain = source.get_distance_gain();
        assert!(!gain.is_nan());
        assert!(gain <= 1.0);
        assert!(gain > 0.0);
        
        // Verificar rango
        assert!(source.is_within_range());
    }

    #[test]
    fn test_spatial_audio_velocity_clamping() {
        // Test 1: Velocidad normal
        let mut source1 = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        source1.set_velocity(AudioPosition::new(50.0, 0.0, 0.0));
        source1.update(0.1);
        assert_eq!(source1.velocity.x, 50.0);
        
        // Test 2: Velocidad mÃ¡xima (100.0) - debe clamping
        let mut source2 = SpatialAudioSource::new("spatial2".to_string(), "Spatial 2".to_string());
        source2.set_velocity(AudioPosition::new(150.0, 0.0, 0.0));
        source2.update(0.1);
        assert_eq!(source2.velocity.x, 100.0); // Clamped a 100.0
        
        // Test 3: Velocidad negativa mÃ¡xima
        let mut source3 = SpatialAudioSource::new("spatial3".to_string(), "Spatial 3".to_string());
        source3.set_velocity(AudioPosition::new(-150.0, 0.0, 0.0));
        source3.update(0.1);
        assert_eq!(source3.velocity.x, -100.0); // Clamped a -100.0
    }

    #[test]
    fn test_spatial_audio_system_operations() {
        let mut spatial = SpatialAudio::new(None);
        
        // Agregar fuentes
        let source1 = SpatialAudioSource::new("source1".to_string(), "Source 1".to_string());
        let source2 = SpatialAudioSource::new("source2".to_string(), "Source 2".to_string());
        
        spatial.add_source(source1);
        spatial.add_source(source2);
        
        assert_eq!(spatial.get_source_count(), 2);
        
        // Obtener fuentes
        assert!(spatial.get_source("source1").is_some());
        assert!(spatial.get_source("source2").is_some());
        assert!(spatial.get_source("source3").is_none());
        
        // Actualizar
        spatial.update(0.1);
        
        // Verificar que las fuentes se actualizaron
        let source1_mut = spatial.get_source_mut("source1").unwrap();
        assert_eq!(source1_mut.position.x, 0.0); // Sin velocidad, posiciÃ³n no cambia
    }

    #[test]
    fn test_spatial_audio_cone_and_listener() {
        let mut source = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        
        // Configurar listener
        source.set_listener(AudioPosition::new(0.0, 0.0, 0.0));
        
        // Configurar cono
        source.cone_inner_angle = 60.0;
        source.cone_outer_angle = 120.0;
        source.cone_volume_factor = 0.5;
        source.cone_outer_volume_factor = 0.2;
        
        assert_eq!(source.cone_inner_angle, 60.0);
        assert_eq!(source.cone_outer_angle, 120.0);
        assert_eq!(source.cone_volume_factor, 0.5);
        assert_eq!(source.cone_outer_volume_factor, 0.2);
        
        // Mover fuente fuera del cono
        source.set_position(AudioPosition::new(100.0, 0.0, 0.0));
        
        // Verificar que estÃ¡ dentro del rango
        assert!(source.is_within_range());
        
        // Verificar ganancia de distancia
        let gain = source.get_distance_gain();
        assert!(gain <= 1.0);
        assert!(gain > 0.0);
    }

    #[test]
    fn test_spatial_audio_distance_and_range() {
        let mut source = SpatialAudioSource::new("spatial1".to_string(), "Spatial 1".to_string());
        source.set_listener(AudioPosition::new(0.0, 0.0, 0.0));
        
        // Test 1: Distancia cero (en el listener)
        source.set_position(AudioPosition::new(0.0, 0.0, 0.0));
        let distance1 = source.get_distance();
        assert!((distance1 - 0.0).abs() < 0.001);
        let gain1 = source.get_distance_gain();
        assert!((gain1 - 1.0).abs() < 0.001); // MÃ¡xima ganancia (cercana a 1.0)
        
        // Test 2: Distancia mÃ­nima (en el min_distance)
        source.set_position(AudioPosition::new(1.0, 0.0, 0.0));
        let distance2 = source.get_distance();
        assert!((distance2 - 1.0).abs() < 0.001);
        
        // Test 3: Distancia mÃ¡xima (fuera del rango)
        source.set_position(AudioPosition::new(2000.0, 0.0, 0.0));
        let distance3 = source.get_distance();
        assert!((distance3 - 2000.0).abs() < 0.001);
        
        // DeberÃ­a estar fuera del rango
        assert!(!source.is_within_range());
        
        // Ganancia debe ser muy baja (atenuaciÃ³n significativa)
        let gain3 = source.get_distance_gain();
        assert!(gain3 < 0.5); // Atenuada significativamente
    }

    #[test]
    fn test_spatial_audio_system_remove_source() {
        let mut spatial = SpatialAudio::new(None);
        
        // Agregar mÃºltiples fuentes
        let source1 = SpatialAudioSource::new("source1".to_string(), "Source 1".to_string());
        let source2 = SpatialAudioSource::new("source2".to_string(), "Source 2".to_string());
        let source3 = SpatialAudioSource::new("source3".to_string(), "Source 3".to_string());
        
        spatial.add_source(source1);
        spatial.add_source(source2);
        spatial.add_source(source3);
        
        assert_eq!(spatial.get_source_count(), 3);
        
        // Remover source2
        spatial.remove_source("source2");
        assert_eq!(spatial.get_source_count(), 2);
        
        // Verificar que source2 ya no existe
        assert!(spatial.get_source("source2").is_none());
        assert!(spatial.get_source("source1").is_some());
        assert!(spatial.get_source("source3").is_some());
        
        // Obtener listener position (deberÃ­a ser promedio de source1 y source3)
        let listener_pos = spatial.get_listener_position();
        // source1 y source3 estÃ¡n en origen, asÃ­ que el promedio tambiÃ©n estÃ¡ en origen
        assert!((listener_pos.x - 0.0).abs() < 0.001);
        assert!((listener_pos.y - 0.0).abs() < 0.001);
        assert!((listener_pos.z - 0.0).abs() < 0.001);
        
        // Remover todas las fuentes
        spatial.remove_source("source1");
        spatial.remove_source("source3");
        assert_eq!(spatial.get_source_count(), 0);
        
        // Listener position deberÃ­a ser origen cuando no hay fuentes
        let listener_pos = spatial.get_listener_position();
        assert_eq!(listener_pos.x, 0.0);
        assert_eq!(listener_pos.y, 0.0);
        assert_eq!(listener_pos.z, 0.0);
    }

    // =========================================================================
    // AUDIO MANAGER TESTS (3 tests)
    // =========================================================================

    #[test]
    fn test_audio_manager_initialization() {
        let manager = AudioManager::new();
        
        assert_eq!(manager.get_source_count(), 0);
        assert_eq!(manager.get_bus_count(), 1);
        assert_eq!(manager.get_channel_count(), 0);
        assert_eq!(manager.get_master_bus_id(), "master_bus");
        assert_eq!(manager.get_sample_rate(), 44100);
    }

    #[test]
    fn test_audio_manager_load_source() {
        let mut manager = AudioManager::new();
        
        let sample = AudioSample::new(
            "sfx1".to_string(),
            "SFX 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        
        let id = manager.load_sample(sample);
        
        assert_eq!(manager.get_source_count(), 1);
        assert_eq!(id, "sfx1");
        
        let source = manager.get_source("sfx1").unwrap();
        assert_eq!(source.get_volume(), 1.0);
    }

    #[test]
    fn test_audio_manager_play_pause_stop() {
        let mut manager = AudioManager::new();
        
        let sample = AudioSample::new(
            "music1".to_string(),
            "Music 1".to_string(),
            std::path::PathBuf::from("test.mp3")
        );
        manager.load_sample(sample);
        
        // Play
        manager.play("music1", None);
        assert_eq!(manager.get_source("music1").unwrap().is_playing(), true);
        
        // Pause
        manager.pause("music1");
        assert_eq!(manager.get_source("music1").unwrap().is_paused(), true);
        
        // Stop
        manager.stop("music1");
        assert_eq!(manager.get_source("music1").unwrap().is_playing(), false);
    }

    #[test]
    fn test_audio_manager_update_and_render() {
        let mut manager = AudioManager::new();
        
        let sample = AudioSample::new(
            "sfx1".to_string(),
            "SFX 1".to_string(),
            std::path::PathBuf::from("test.wav")
        );
        manager.load_sample(sample);
        
        manager.play("sfx1", None);
        manager.update(0.1);
        
        // Verificar que se actualizÃ³
        assert!(manager.get_source("sfx1").unwrap().get_position() > 0.0);
        
        // Render debe actualizar
        manager.render();
        assert!(manager.get_source("sfx1").unwrap().get_position() > 0.0);
    }

    #[test]
    fn test_audio_manager_spatial_and_effects() {
        let mut manager = AudioManager::new();
        
        // Agregar fuente espacial
        let spatial_source = SpatialAudioSource::new(
            "spatial1".to_string(),
            "Spatial 1".to_string()
        );
        manager.add_spatial_source(spatial_source);
        
        // Verificar que la fuente espacial se agregÃ³ (get_source_count no cuenta espaciales)
        assert_eq!(manager.get_source_count(), 0);
        
        // Agregar efecto a bus
        let effect = AudioEffect::new(
            "reverb".to_string(),
            "Reverb".to_string(),
            crate::audio_effects::EffectType::Reverb
        );
        manager.add_effect_to_bus("master_bus", effect);
        
        // Verificar que el efecto se agregÃ³ al bus
        assert_eq!(manager.get_bus_count(), 1);
    }

