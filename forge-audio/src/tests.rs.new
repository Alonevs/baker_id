    // =========================================================================
    // AUDIO MIXER TESTS (3 tests)
    // =========================================================================

    #[test]
    fn test_audio_mixer_default_config() {
        let mixer = AudioMixer::new(None);
        
        assert_eq!(mixer.config.master_volume, 1.0);
        assert_eq!(mixer.config.sample_rate, 44100);
        assert_eq!(mixer.config.channels, 2);
        assert_eq!(mixer.config.buffer_size, 1024);
        assert_eq!(mixer.master_volume, 1.0);
        assert!(mixer.output_buffer.is_empty());
    }

    #[test]
    fn test_audio_mixer_channel_operations() {
        let mut mixer = AudioMixer::new(None);
        
        // Crear canal
        let channel = MixerChannel::new("ch1".to_string(), "Channel 1".to_string());
        mixer.add_channel(channel);
        
        assert_eq!(mixer.get_channel_count(), 1);
        
        // Obtener canal
        let channel = mixer.get_channel("ch1").unwrap();
        assert_eq!(channel.volume, 1.0);
        assert_eq!(channel.pan, 0.0);
        assert_eq!(channel.pitch, 1.0);
        assert!(!channel.muted);
        assert!(!channel.solo);
        
        // Modificar volumen
        mixer.get_channel_mut("ch1").unwrap().set_volume(0.5);
        assert_eq!(mixer.get_channel("ch1").unwrap().volume, 0.5);
        
        // Toggle mute
        mixer.get_channel_mut("ch1").unwrap().toggle_mute();
        assert!(mixer.get_channel("ch1").unwrap().muted);
        
        mixer.get_channel_mut("ch1").unwrap().toggle_mute();
        assert!(!mixer.get_channel("ch1").unwrap().muted);
    }

    #[test]
    fn test_audio_mixer_mixing() {
        let mut mixer = AudioMixer::new(None);
        
        // Agregar canales
        let mut channel1 = MixerChannel::new("ch1".to_string(), "Channel 1".to_string());
        channel1.set_volume(0.5);
        mixer.add_channel(channel1);
        
        let mut channel2 = MixerChannel::new("ch2".to_string(), "Channel 2".to_string());
        channel2.set_volume(0.3);
        mixer.add_channel(channel2);
        
        // Mezclar
        mixer.mix(0.016);
        
        // Verificar buffer de salida
        assert!(!mixer.output_buffer.is_empty());
        assert_eq!(mixer.get_master_volume(), 1.0);
    }

    #[test]
    fn test_audio_mixer_volume_clamping() {
        let mut mixer = AudioMixer::new(None);
        
        // Canal con volumen > 1.0 (debe clampear a 1.0)
        let mut channel1 = MixerChannel::new("ch1".to_string(), "Channel 1".to_string());
        channel1.set_volume(1.5);
        assert_eq!(channel1.volume, 1.0);
        
        // Canal con volumen < 0.0 (debe clampear a 0.0)
        let mut channel2 = MixerChannel::new("ch2".to_string(), "Channel 2".to_string());
        channel2.set_volume(-0.5);
        assert_eq!(channel2.volume, 0.0);
        
        // Canal con volumen normal
        let mut channel3 = MixerChannel::new("ch3".to_string(), "Channel 3".to_string());
        channel3.set_volume(0.75);
        assert_eq!(channel3.volume, 0.75);
        
        mixer.add_channel(channel1);
        mixer.add_channel(channel2);
        mixer.add_channel(channel3);
    }

    #[test]
    fn test_audio_mixer_master_volume() {
        let mut mixer = AudioMixer::new(None);
        
        // Volumen maestro > 1.0 (debe clampear a 1.0)
        mixer.set_master_volume(1.5);
        assert_eq!(mixer.get_master_volume(), 1.0);
        
        // Volumen maestro < 0.0 (debe clampear a 0.0)
        mixer.set_master_volume(-0.5);
        assert_eq!(mixer.get_master_volume(), 0.0);
        
        // Volumen maestro normal
        mixer.set_master_volume(0.8);
        assert_eq!(mixer.get_master_volume(), 0.8);
        
        // Volumen maestro por defecto
        let mixer2 = AudioMixer::new(None);
        assert_eq!(mixer2.get_master_volume(), 1.0);
    }

    #[test]
    fn test_audio_mixer_mute_and_solo() {
        let mut mixer = AudioMixer::new(None);
        
        let mut channel1 = MixerChannel::new("ch1".to_string(), "Channel 1".to_string());
        channel1.set_volume(0.5);
        mixer.add_channel(channel1.clone());
        
        let mut channel2 = MixerChannel::new("ch2".to_string(), "Channel 2".to_string());
        channel2.set_volume(0.5);
        mixer.add_channel(channel2.clone());
        
        // Toggle mute
        channel1.toggle_mute();
        assert!(channel1.muted);
        
        // Toggle mute again
        channel1.toggle_mute();
        assert!(!channel1.muted);
        
        // Toggle solo
        channel2.toggle_solo();
        assert!(channel2.solo);
        
        // Toggle solo again
        channel2.toggle_solo();
        assert!(!channel2.solo);
        
        // Verificar que se pueden obtener canales
        assert!(mixer.get_channel("ch1").is_some());
        assert!(mixer.get_channel_mut("ch2").is_some());
        
        // Verificar count
        assert_eq!(mixer.get_channel_count(), 2);
    }

