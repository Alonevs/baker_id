    #[test]
    fn test_audio_effect_creation() {
        let effect = AudioEffect::new(
            "effect1".to_string(),
            "Effect 1".to_string(),
            EffectType::Reverb
        );
        
        assert_eq!(effect.id, "effect1");
        assert_eq!(effect.name, "Effect 1");
        assert_eq!(effect.effect_type, EffectType::Reverb);
        assert!(effect.enabled);
        assert!(!effect.bypassed);
        
        // Verificar config default
        assert_eq!(effect.config.effect_type, EffectType::Reverb);
        assert_eq!(effect.config.params.get("wet").unwrap(), &0.5);
        assert_eq!(effect.config.params.get("dry").unwrap(), &1.0);
    }

    #[test]
    fn test_audio_effects_processing() {
        let mut effects = AudioEffects::new();
        
        // Agregar efecto
        let mut effect = AudioEffect::new(
            "reverb".to_string(),
            "Reverb".to_string(),
            EffectType::Reverb
        );
        effect.set_param("wet".to_string(), 0.7);
        effects.add_effect(effect);
        
        // Procesar muestra
        let input = 0.5;
        let output = effects.process_sample(input);
        
        assert!(!effects.effects.is_empty());
        assert_eq!(effects.get_effect_count(), 1);
        
        // Output debe estar atenuado por wet
        assert!(output < input * 1.0);
    }

    #[test]
    fn test_audio_effects_bypass() {
        let mut effects = AudioEffects::new();
        
        let effect = AudioEffect::new(
            "distortion".to_string(),
            "Distortion".to_string(),
            EffectType::Distortion
        );
        effects.add_effect(effect);
        
        // Procesar con efecto activo
        let input = 0.8;
        let output_enabled = effects.process_sample(input);
        
        // Bypassear efecto
        effects.get_effect_mut("distortion").unwrap().toggle_bypass();
        let output_bypassed = effects.process_sample(input);
        
        // Reactivar
        effects.get_effect_mut("distortion").unwrap().toggle_bypass();
        let output_reenabled = effects.process_sample(input);
        
        assert!(!output_enabled.is_nan());
        assert!(!output_bypassed.is_nan());
        assert!(!output_reenabled.is_nan());
    }

    #[test]
    fn test_audio_effects_multiple_types() {
        let mut effects = AudioEffects::new();
        
        // Agregar efectos de diferentes tipos
        let reverb = AudioEffect::new(
            "reverb".to_string(),
            "Reverb".to_string(),
            EffectType::Reverb
        );
        let delay = AudioEffect::new(
            "delay".to_string(),
            "Delay".to_string(),
            EffectType::Delay
        );
        let chorus = AudioEffect::new(
            "chorus".to_string(),
            "Chorus".to_string(),
            EffectType::Chorus
        );
        
        effects.add_effect(reverb);
        effects.add_effect(delay);
        effects.add_effect(chorus);
        
        assert_eq!(effects.get_effect_count(), 3);
        
        // Procesar muestra con mÃºltiples efectos
        let input = 0.5;
        let output = effects.process_sample(input);
        
        assert!(!output.is_nan());
        assert!(!output.is_infinite());
        
        // Verificar que se pueden obtener efectos
        assert!(effects.get_effect("reverb").is_some());
        assert!(effects.get_effect("delay").is_some());
        assert!(effects.get_effect("chorus").is_some());
    }

    #[test]
    fn test_audio_effects_distortion_and_compressor() {
        // Probar distorsiÃ³n
        let mut effects = AudioEffects::new();
        let distortion = AudioEffect::new(
            "distortion".to_string(),
            "Distortion".to_string(),
            EffectType::Distortion
        );
        effects.add_effect(distortion);
        
        // DistorsiÃ³n amplifica: input.clamp(-1.0, 1.0) * 2.0
        let input = 0.8;
        let output = effects.process_sample(input);
        assert!(output.abs() > input); // Amplificado
        assert!(output.abs() <= 2.0); // Clamped
        
        // Probar compresor
        let mut effects2 = AudioEffects::new();
        let compressor = AudioEffect::new(
            "compressor".to_string(),
            "Compressor".to_string(),
            EffectType::Compressor
        );
        effects2.add_effect(compressor);
        
        // Compressor limita a Â±0.5
        let input = 2.0;
        let output = effects2.process_sample(input);
        assert!(output.abs() <= 0.5);
    }

    #[test]
    fn test_audio_effects_remove_and_get() {
        let mut effects = AudioEffects::new();
        
        // Agregar efectos
        let effect1 = AudioEffect::new(
            "effect1".to_string(),
            "Effect 1".to_string(),
            EffectType::Reverb
        );
        let effect2 = AudioEffect::new(
            "effect2".to_string(),
            "Effect 2".to_string(),
            EffectType::Delay
        );
        
        effects.add_effect(effect1);
        effects.add_effect(effect2);
        
        assert_eq!(effects.get_effect_count(), 2);
        
        // Remover efecto
        effects.remove_effect("effect1");
        assert_eq!(effects.get_effect_count(), 1);
        
        // Verificar que effect1 ya no existe
        assert!(effects.get_effect("effect1").is_none());
        assert!(effects.get_effect("effect2").is_some());
        
        // Agregar y remover otro efecto
        let effect3 = AudioEffect::new(
            "effect3".to_string(),
            "Effect 3".to_string(),
            EffectType::Chorus
        );
        effects.add_effect(effect3);
        assert_eq!(effects.get_effect_count(), 2);
        
        effects.remove_effect("effect3");
        assert_eq!(effects.get_effect_count(), 1);
    }

    // =========================================================================
    // AUDIO SOURCE TESTS (3 tests)
